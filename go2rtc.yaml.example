# go2rtc.yaml.example — 中継サーバー設定の雛形
# 実ファイル(go2rtc.yaml)は中継サーバーPCのローカルで管理し、リポジトリにコミットしない
# (RTSPのユーザー名・パスワード・カメラIPを含むため。docs/camera_setup_guide.md 参照)

streams:
  # ストリーム名(キー)は camera_grid.html の設定画面で使う名前
  # Tapoカメラ: rtsp://<RTSPユーザー>:<パスワード>@<カメラIP>:554/stream1
  #   stream1=高画質 / stream2=低画質(帯域が厳しい場合はstream2)
  # カメラC210は全7台。IP・RTSPユーザー/パスワードは付録A(カメラ台帳)確定後に書き換える。
  # コメント(#設置場所)は台帳の設置場所に合わせて更新する。
  cam1: rtsp://USER:PASSWORD@CAMERA_IP_1:554/stream1   # 設置場所1
  cam2: rtsp://USER:PASSWORD@CAMERA_IP_2:554/stream1   # 設置場所2
  cam3: rtsp://USER:PASSWORD@CAMERA_IP_3:554/stream1   # 設置場所3
  cam4: rtsp://USER:PASSWORD@CAMERA_IP_4:554/stream1   # 設置場所4
  cam5: rtsp://USER:PASSWORD@CAMERA_IP_5:554/stream1   # 設置場所5
  cam6: rtsp://USER:PASSWORD@CAMERA_IP_6:554/stream1   # 設置場所6
  cam7: rtsp://USER:PASSWORD@CAMERA_IP_7:554/stream1   # 設置場所7

api:
  listen: ":1984"   # ブラウザからのアクセスポート(camera_grid.htmlに設定するURL)

# GitHub Pages(HTTPS)から映像を見る場合は自己署名証明書でHTTPS化する
# (証明書の作成手順は docs/camera_setup_guide.md の「HTTPS対応」参照)
# api:
#   listen: ":1984"
#   tls_listen: ":1985"
#   tls_cert: cert.pem
#   tls_key: key.pem
