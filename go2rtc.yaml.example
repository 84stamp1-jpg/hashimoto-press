# go2rtc.yaml.example — 中継サーバー設定の雛形
# 実ファイル(go2rtc.yaml)は中継サーバーPCのローカルで管理し、リポジトリにコミットしない
# (RTSPのユーザー名・パスワード・カメラIPを含むため。docs/camera_setup_guide.md 参照)

streams:
  # ストリーム名(キー)は camera_grid.html の設定画面で使う名前
  # Tapoカメラ: rtsp://<RTSPユーザー>:<パスワード>@<カメラIP>:554/stream1
  #   stream1=高画質 / stream2=低画質(帯域が厳しい場合はstream2)
  cam1: rtsp://USER:PASSWORD@192.168.1.101:554/stream1
  cam2: rtsp://USER:PASSWORD@192.168.1.102:554/stream1
  cam3: rtsp://USER:PASSWORD@192.168.1.103:554/stream1

api:
  listen: ":1984"   # ブラウザからのアクセスポート(camera_grid.htmlに設定するURL)

# GitHub Pages(HTTPS)から映像を見る場合は自己署名証明書でHTTPS化する
# (証明書の作成手順は docs/camera_setup_guide.md の「HTTPS対応」参照)
# api:
#   listen: ":1984"
#   tls_listen: ":1985"
#   tls_cert: cert.pem
#   tls_key: key.pem
