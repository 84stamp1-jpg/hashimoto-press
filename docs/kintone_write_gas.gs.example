/**
 * H-Hub → kintone 書き込み用 GAS（まるごと1ファイル・そのまま貼り付けて使う）
 * =====================================================================
 * これは「新しく作る」Apps Scriptプロジェクトの中身です。
 * 既存の品質チェックGASには一切さわりません（壊す心配がありません）。
 *
 * 手順書: docs/kintone_write_gas_setup.md
 *
 * 何をするか:
 *   H-Hub の 品質チェック →「システム入力待ち」→ 右の不良品報告ペインから、
 *     ・在庫管理の「入力者」「入力日」を書き込む   （op:'record'）
 *     ・プロセス管理を進める（在庫調整／在庫投入） （op:'status'）
 *
 * 安全のため:
 *   ・APIトークンはこのGASに保存しません。H-Hub側（各PCのlocalStorage）から毎回届きます
 *   ・書き込みを許すアプリIDを下の ALLOWED_APPS で限定しています
 *   ・読み取り（照合）はこのGASを通りません。既存の品質チェックGASのままです
 */

// 書き込みを許可するkintoneアプリID。★不良品報告=31。増やすときはカンマで足す
var ALLOWED_APPS = ['31'];


/** H-Hubからの受け口。ここが入口です */
function doPost(e) {
  var out;
  try {
    var p = JSON.parse(e.postData.contents);
    if (p.action === 'ping') {
      out = { ok: true, msg: '書き込み用GASは動いています' };
    } else if (p.action === 'kintoneWrite') {
      out = kintoneWrite_(p);
    } else {
      out = { ok: false, err: '知らないaction: ' + p.action };
    }
  } catch (err) {
    out = { ok: false, err: String(err) };
  }
  return ContentService.createTextOutput(JSON.stringify(out))
    .setMimeType(ContentService.MimeType.JSON);
}

/** ブラウザでURLを直接開いたときの表示（動作確認用） */
function doGet(e) {
  return ContentService
    .createTextOutput(JSON.stringify({ ok: true, msg: 'H-Hub kintone書き込み用GAS' }))
    .setMimeType(ContentService.MimeType.JSON);
}


/**
 * kintoneへの書き込み本体
 *   p.domain       'hashimoto-kogyo'
 *   p.appId        '31'
 *   p.token        APIトークン（レコード編集／ステータス変更の権限つき）
 *   p.op           'record'（フィールドを更新） / 'status'（プロセス管理を進める）
 *   p.id           レコード番号
 *   p.record       op='record' のとき { フィールドコード: {value: ...}, ... }
 *   p.statusAction op='status' のとき 実行するアクション名（例 '在庫調整'）
 *   p.assignee     op='status' で次の作業者を指定する場合のログイン名（任意）
 */
function kintoneWrite_(p) {
  if (!p.domain || !p.appId || !p.token || !p.id) {
    return { ok: false, err: 'domain / appId / token / id が足りません' };
  }
  if (ALLOWED_APPS.indexOf(String(p.appId)) < 0) {
    return { ok: false, err: 'アプリID ' + p.appId + ' への書き込みは許可されていません（ALLOWED_APPSを確認）' };
  }

  var base = 'https://' + p.domain + '.cybozu.com/k/v1/';
  var url, payload;

  if (p.op === 'status') {
    if (!p.statusAction) return { ok: false, err: 'statusAction（アクション名）が指定されていません' };
    url = base + 'record/status.json';
    payload = { app: p.appId, id: p.id, action: p.statusAction };
    if (p.assignee) payload.assignee = p.assignee;

  } else {
    if (!p.record || !Object.keys(p.record).length) {
      return { ok: false, err: 'record（更新する内容）が空です' };
    }
    url = base + 'record.json';
    payload = { app: p.appId, id: p.id, record: p.record };
  }

  var res = UrlFetchApp.fetch(url, {
    method: 'put',
    contentType: 'application/json',
    headers: { 'X-Cybozu-API-Token': p.token },
    payload: JSON.stringify(payload),
    muteHttpExceptions: true
  });

  var code = res.getResponseCode();
  var text = res.getContentText();

  if (code >= 200 && code < 300) {
    var body = {};
    try { body = JSON.parse(text); } catch (e) {}
    return { ok: true, revision: body.revision || null };
  }

  // kintone側のエラーはそのまま返す。原因が画面で分かるようにする
  var msg = text;
  try {
    var er = JSON.parse(text);
    msg = (er.message || '') + (er.code ? '（' + er.code + '）' : '');
    if (er.errors) msg += ' ' + JSON.stringify(er.errors);
  } catch (e2) {}
  return { ok: false, err: 'kintone ' + code + ': ' + msg };
}


/**
 * ■ よくあるエラーと原因
 *
 *  つながりません / Failed to fetch
 *      デプロイの「アクセスできるユーザー」が「全員」になっていない。
 *      デプロイを管理 → 鉛筆 → アクセスできるユーザー: 全員 → デプロイ
 *
 *  403 / GAIA_NO01
 *      APIトークンに「レコード編集」（プロセスなら「ステータス変更」）の権限が無い。
 *      kintoneでアクセス権を足したあと、右上の「アプリを更新」を押し忘れていないか確認。
 *
 *  400 / GAIA_IL26
 *      statusAction のアクション名が、そのアプリのプロセス管理の設定と一致していない。
 *      kintone → アプリの設定 → プロセス管理 で「アクション名」を確認し、
 *      H-Hubの「⚙ 不良品報告の設定」のアクション①／②に同じ文字列を入れる。
 *
 *  400 / GAIA_IQ11
 *      いまのステータスからそのアクションは実行できない（順番が違う）。
 *
 *  400 / GAIA_LO04
 *      ルックアップの引き当てに失敗。原因は2つ。
 *      (a) 値が参照先アプリのキーと一致していない（全角/半角空白、氏名か社員コードか）
 *      (b) ★参照先アプリを読む権限がない。APIトークンは1アプリ分の権限しか持たないため、
 *          kintoneがルックアップを解決しようとしても参照先（社員マスタ等）を読めず弾かれる。
 *          → 参照先アプリでも「レコード閲覧」トークンを作り、
 *            H-Hubの⚙設定「参照先アプリのAPIトークン」に入れる。
 *            kintoneは X-Cybozu-API-Token にカンマ区切りで複数トークンを受け付けるので、
 *            H-Hub側が "tokenA,tokenB" の形で送ってくる。このGASは受け取った文字列を
 *            そのままヘッダーに入れるだけなので、コードの変更は要らない。
 *
 *  400 / CB_VA01
 *      フィールドの型と値が合っていない。
 *      「入力者」がユーザー選択なら、設定の「入力者の名前」は表示名ではなく
 *      kintoneの<ログイン名>を入れること。
 */
